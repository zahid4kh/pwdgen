#!/bin/bash
# repo-update - Automated Debian repository maintenance script
# This script updates the repository metadata, calculates checksums, and signs the Release files

set -e  # Exit on any error

# Configuration
DIST="stable"
COMPONENT="main"
ARCH="amd64"
VERSION="1.0.4"
GPG_KEY="F6C1BB08C8138D234A54D3D30940F1449316DE37"
DESCRIPTION="Repository for PwdGen - Secure Password Generator"
LABEL="PwdGen Repository"
ORIGIN="Zahid Khalilov"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'  # No Color

# Function to print colored messages
log() {
    local level=$1
    local message=$2
    
    case $level in
        "info")
            echo -e "${BLUE}[INFO]${NC} $message"
            ;;
        "success")
            echo -e "${GREEN}[SUCCESS]${NC} $message"
            ;;
        "warning")
            echo -e "${YELLOW}[WARNING]${NC} $message"
            ;;
        "error")
            echo -e "${RED}[ERROR]${NC} $message"
            ;;
    esac
}

# Check if required commands are available
for cmd in dpkg-scanpackages gzip bzip2 gpg apt-ftparchive; do
    if ! command -v $cmd &> /dev/null; then
        log "error" "$cmd command not found. Please install it."
        exit 1
    fi
done

# Create repository structure if it doesn't exist
mkdir -p "pool/main/p/pwdgen"
mkdir -p "dists/$DIST/$COMPONENT/binary-$ARCH"

# Verify there are .deb files in the pool
DEB_COUNT=$(find "pool/main/p/pwdgen" -name "*.deb" | wc -l)
if [ "$DEB_COUNT" -eq 0 ]; then
    log "error" "No .deb files found in pool/main/p/pwdgen. Please add your .deb file first."
    exit 1
fi

# Generate Packages file
log "info" "Generating Packages file..."
# Go to the root directory to make paths relative
cd "$(pwd)"
dpkg-scanpackages --multiversion pool/main/p/pwdgen > "dists/$DIST/$COMPONENT/binary-$ARCH/Packages"

# Verify Packages file is not empty
if [ ! -s "dists/$DIST/$COMPONENT/binary-$ARCH/Packages" ]; then
    log "error" "Generated Packages file is empty. Please check the .deb files."
    exit 1
fi

# Compress Packages file
gzip -9c "dists/$DIST/$COMPONENT/binary-$ARCH/Packages" > "dists/$DIST/$COMPONENT/binary-$ARCH/Packages.gz"
bzip2 -9c "dists/$DIST/$COMPONENT/binary-$ARCH/Packages" > "dists/$DIST/$COMPONENT/binary-$ARCH/Packages.bz2"

# Create apt-ftparchive configuration
log "info" "Creating Release configuration..."
cat > /tmp/apt-release.conf << EOF
APT::FTPArchive::Release {
  Origin "$ORIGIN";
  Label "$LABEL";
  Suite "$DIST";
  Codename "$DIST";
  Version "$VERSION";
  Architectures "$ARCH";
  Components "$COMPONENT";
  Description "$DESCRIPTION";
};
EOF

# Generate Release file
log "info" "Generating Release file..."
cd "dists/$DIST"
apt-ftparchive -c /tmp/apt-release.conf release . > Release.new
mv Release.new Release
cd ../..
rm /tmp/apt-release.conf

# Export GPG key
log "info" "Exporting GPG key..."
gpg --export --armor "$GPG_KEY" > "KEY.gpg"

# Sign Release file
log "info" "Signing Release file..."
gpg --default-key "$GPG_KEY" -abs -o "dists/$DIST/Release.gpg" "dists/$DIST/Release"
gpg --default-key "$GPG_KEY" --clearsign -o "dists/$DIST/InRelease" "dists/$DIST/Release"

log "success" "Repository updated successfully!"
log "info" "You can now push the repository to GitHub Pages."